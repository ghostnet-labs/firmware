From: stupidmonk37 <198526109+stupidmonk37@users.noreply.github.com>
Subject: [PATCH] arm64: dts: rockchip: nanopc-t6-lts: enable GNSS and header I2C

OpenMANET nodes carry a GNSS receiver with a 1PPS output and an I2C
battery monitor. Wire them to the 40-pin header the same way a
Raspberry Pi GNSS HAT is wired:

  pin  3  GPIO1_D7  I2C8_SDA_M2  <-> monitor SDA  (/dev/i2c-8)
  pin  5  GPIO1_D6  I2C8_SCL_M2  <-> monitor SCL
  pin  8  GPIO0_C5  UART0_TX_M0  -> GNSS RX
  pin 10  GPIO0_C4  UART0_RX_M0  <- GNSS TX       (/dev/ttyS0)
  pin 12  GPIO3_B7  pps-gpio     <- GNSS 1PPS     (/dev/pps0)

All five pins are 3.3 V and otherwise unused on the LTS board; pins 3
and 5 already have 2.2K pull-ups. The PPS pin is pulled down so an
unpopulated header gives no pulses.

The monitor is the INA228 used on every bench track (Adafruit 5832,
15 mOhm shunt, address 0x40), bound by the ina238 driver with the
v6.17 INA228 backport. Declaring it here passes the shunt value, which
a sysfs new_device instantiation cannot. With no chip fitted the probe
simply fails.

Signed-off-by: stupidmonk37 <198526109+stupidmonk37@users.noreply.github.com>
---
--- a/arch/arm64/boot/dts/rockchip/rk3588-nanopc-t6-lts.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-nanopc-t6-lts.dts
@@ -14,6 +14,14 @@
 	model = "FriendlyElec NanoPC-T6 LTS";
 	compatible = "friendlyarm,nanopc-t6-lts", "rockchip,rk3588";
 
+	/* GNSS 1PPS on 40-pin header pin 12 */
+	pps {
+		compatible = "pps-gpio";
+		gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&gnss_pps_pin>;
+	};
+
 	/* provide power for on-board USB 2.0 hub */
 	vcc5v0_usb20_host: vcc5v0-usb20-host-regulator {
 		compatible = "regulator-fixed";
@@ -30,7 +38,26 @@
 	};
 };
 
+/* I2C on 40-pin header pins 3 (SDA) and 5 (SCL) */
+&i2c8 {
+	status = "okay";
+
+	/* Pack monitor: Adafruit 5832 INA228 breakout, 15 mOhm shunt */
+	power-monitor@40 {
+		compatible = "ti,ina228";
+		reg = <0x40>;
+		shunt-resistor = <15000>;
+		ti,shunt-gain = <4>;
+	};
+};
+
 &pinctrl {
+	gnss {
+		gnss_pps_pin: gnss-pps-pin {
+			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+
 	usb {
 		usb20_host_pwren: usb20-host-pwren {
 			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
@@ -46,6 +73,12 @@
 	status = "okay";
 };
 
+/* GNSS NMEA on 40-pin header pins 8 (TX) and 10 (RX) */
+&uart0 {
+	pinctrl-0 = <&uart0m0_xfer>;
+	status = "okay";
+};
+
 &u2phy2_host {
 	phy-supply = <&vcc5v0_usb20_host>;
 };
