# Generic x86_64 image, built for the Protectli Vault Pro VP2430 bench node
# (Intel N150, four i226-V 2.5 GbE). The generic device boots any 64-bit
# UEFI or legacy-BIOS PC; everything Protectli-specific is in bsp-x86 and
# keys off the DMI board name at run time.
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_VERSION_MANUFACTURER="Protectli"
CONFIG_VERSION_PRODUCT="x86_64"

CONFIG_PACKAGE_bsp-x86=y

# Root filesystem: squashfs only (the ext4 variants double the build for no
# bench use). 2 GiB leaves room for the overlay on the box's SSD.
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_TITLE="OpenMANET"
CONFIG_ISO_IMAGES=n
CONFIG_VDI_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_VHDX_IMAGES=n
CONFIG_QCOW2_IMAGES=n

# Morse Micro: USB-attached MM8108 (Gateworks GW16167 on a Pier42 USB
# carrier). Only the mm8108 driver is built; see boards/ekh-bcm2711/
# target_diffconfig for why the Morse driver has to be =y rather than =m.
CONFIG_PACKAGE_kmod-mm8108=y
CONFIG_PACKAGE_mm8108-firmware=y
CONFIG_PACKAGE_kmod-mm6108=n
CONFIG_PACKAGE_mm6108-firmware=n
CONFIG_PACKAGE_kmod-morse=n
CONFIG_PACKAGE_morse-board-config=n
CONFIG_MORSE_USB=y
CONFIG_PACKAGE_libusb-1.0=y

# Wi-Fi mesh: AsiaRF AW7916-AED (MT7916) in the box's M.2 E-key slot.
# kmod-mt7915e and kmod-mt7916-firmware already come from
# boards/common/openmanet_diffconfig; pinned here so the bench node cannot
# lose them.
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y

# Ethernet: four Intel i226-V (igc). Also in the generic device's
# DEVICE_PACKAGES; pinned for the same reason.
CONFIG_PACKAGE_kmod-igc=y

# GNSS: NMEA on the RS-232 COM port (/dev/ttyS1) and PPS on its DCD line,
# through the pps-ldisc line discipline (/dev/pps0). See bsp-x86.
CONFIG_PACKAGE_kmod-pps-ldisc=y
CONFIG_PACKAGE_pps-tools=y
CONFIG_PACKAGE_setserial=y

# Battery telemetry: an Adafruit INA228 on an MCP2221A USB-I2C bridge, read
# through the ina238 hwmon driver with the v6.17 INA228 backport
# (target/linux/x86/patches-6.6/993-*). Same chip as the CM5 track and V1.
# Linux 6.6 cannot drive the INA260. i2c-tools for bring-up.
CONFIG_PACKAGE_kmod-usb-hid-mcp2221=y
CONFIG_PACKAGE_kmod-hwmon-ina238=y
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_i2c-tools=y

# OpenMANET Voice Link Module (VLMKW0100): USB Audio Class and HID/PTT.
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_alsa-lib=y
CONFIG_PACKAGE_alsa-utils=y

# 9P: boards/common/kmods_diffconfig turns on kmod-fs-9p (and so 9pnet) for
# every board. On x86_64 CONFIG_XEN=y makes NET_9P_XEN visible, and only
# kmod-9pvirtio sets it, so without this the kernel config stops at a
# "9P Xen Transport (NET_9P_XEN) (NEW)" prompt and the build fails. 9P over
# virtio is also what a VM test run of this image would use.
CONFIG_PACKAGE_kmod-9pvirtio=m

# x86 platform: CPU microcode, CPU temperatures and NVMe/SATA boot media.
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_iucode-tool=y
CONFIG_PACKAGE_kmod-hwmon-coretemp=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_ethtool=y

# Hardware watchdog in the VP2430's ITE IT8659E Super I/O (it87_wdt).
CONFIG_PACKAGE_kmod-it87-wdt=y
