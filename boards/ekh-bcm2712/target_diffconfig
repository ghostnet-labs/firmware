CONFIG_TARGET_MULTI_PROFILE=y

# Per-device rootfs: every image starts from the shared rootfs (all =y
# packages), then that device's TARGET_DEVICE_PACKAGES list (below) is
# applied on top during image assembly.
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2712=y
CONFIG_TARGET_DEVICE_bcm27xx_bcm2712_DEVICE_bcm2712_mm8108-usb=y

# Raspberry Pi 5 / CM5 with a USB-attached MM8108 (e.g. Gateworks GW16167).
# Only the mm8108 driver is built; see boards/ekh-bcm2711/target_diffconfig
# for why the Morse driver has to be =y rather than =m.
CONFIG_PACKAGE_kmod-mm8108=y
CONFIG_PACKAGE_mm8108-firmware=y
CONFIG_PACKAGE_kmod-mm6108=n
CONFIG_PACKAGE_mm6108-firmware=n

# wpad-basic-mbedtls is inherited from the upstream rpi-5 profile
# DEVICE_PACKAGES and would clash with wpad-openssl.
CONFIG_TARGET_DEVICE_PACKAGES_bcm27xx_bcm2712_DEVICE_bcm2712_mm8108-usb="-wpad-basic-mbedtls kmod-bluetooth bluez-daemon bluez-utils"

CONFIG_VERSION_MANUFACTURER="Raspberry Pi"
CONFIG_VERSION_PRODUCT="BCM2712"

CONFIG_PACKAGE_bsp-bcm271x=y
CONFIG_PACKAGE_mavp2p=m

CONFIG_TARGET_ROOTFS_PARTSIZE=4092

# Mini-PCIe Wi-Fi on CM5 carriers (QCA988x, e.g. Compex WLE900VX).
CONFIG_PACKAGE_ath10k-firmware-qca988x=y
CONFIG_PACKAGE_ath10k-board-qca988x=y

# GNSS PPS via the pps-gpio overlay in distroconfig.txt (/dev/pps0).
CONFIG_PACKAGE_kmod-pps-gpio=y
CONFIG_PACKAGE_pps-tools=y

# Bit-banged I2C for the UPS INA219 via the i2c-gpio overlay in
# distroconfig.txt. GNSS NMEA comes in over a CH340 USB-UART
# (kmod-usb-serial-ch341, already in the common config) as /dev/ttyUSB0.
CONFIG_PACKAGE_kmod-i2c-gpio=y

# CM5 POC onboard Bluetooth (CYW43455 on UART, hci_uart + btbcm), GHO-47.
# Build the packages without adding them to the shared rootfs: only the
# mm8108-usb device installs them above. V1 intentionally has no Bluetooth.
CONFIG_PACKAGE_kmod-bluetooth=m
CONFIG_PACKAGE_bluez-daemon=m
CONFIG_PACKAGE_bluez-utils=m

# OpenMANET Voice Link Module (VLMKW0100): USB Audio Class and HID/PTT.
# ALSA userspace is included for the CM5/OpenMANET audio path; the VLM
# remains an external node accessory on the dedicated USB host port.
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_alsa-lib=y
CONFIG_PACKAGE_alsa-utils=y

# INA219/INA2xx battery/UPS monitors on I2C.
CONFIG_PACKAGE_kmod-hwmon-ina2xx=y

# vcgencmd (get_throttled, pmic_read_adc) for GHO-30 power telemetry. Already
# a bcm27xx target default; pinned so the bench telemetry cannot lose it.
CONFIG_PACKAGE_bcm27xx-utils=y

# Fan header on the CM5 IO boards / Pi 5 active cooler.
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# Disable ext4 image creation.
CONFIG_TARGET_ROOTFS_EXT4FS=n
